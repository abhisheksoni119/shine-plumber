OPENAI_API_KEY=<your_openai_key>
OPENAI_MODEL=gpt-4.1-mini

SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Where your current resume exists (markdown preferred)
RESUME_FILE=resume.md

# Destination email for applications (or your own mailbox for review)
TARGET_EMAIL=recruiter@example.com
MY_EMAIL=you@example.com

# RUN_MODE=once or schedule
RUN_MODE=once
